---
// "Bit" — an original brick-built bird who watches your cursor and has opinions.
// Pure SVG + vanilla JS. No WebGL, no video, no dependencies.
//
// Interactions:
//  - Eyes track the cursor independently (he goes cross-eyed up close)
//  - Hover: brows lift, he looks curious
//  - Click / tap / Enter: hop + wing flap + a quip, and a brick stacks on his head
//    (the 5th brick topples the tower)
//  - Idle ~12s with a mouse: falls asleep (Zzz); moving wakes him
//  - Type "bit" anywhere: he dances
//  - Play enough and an egg drops, wobbles and hatches Bitty, a baby brick who copies his dad
//    (remembered per visitor in localStorage)
//  - Type "flash" anywhere: a 1999-style Flash intro loader (with SKIP INTRO), then Bit pops out
//  - Moods: tickle him (wiggle over him) and he giggles; click too fast and he gets grumpy;
//    every so often he drifts into a mood by himself (happy, bored)
const headStuds = [153, 223, 293, 363];
const plateStuds = Array.from({ length: 13 }, (_, i) => 20 + i * 41);
---
<div class="mascot" data-mascot>
  <div class="m-bubble" data-bubble role="status" aria-live="polite"></div>

  <button class="m-hit" type="button" data-hit aria-label="Poke Bit, the brick-built bird">
    <svg viewBox="0 0 560 560" aria-hidden="true" focusable="false">
      <!-- baseplate -->
      {plateStuds.map((x) => <rect class="stud s-green" x={x} y="488" width="26" height="14" rx="3" />)}
      <rect class="b-green" x="10" y="498" width="540" height="40" rx="6" />
      <rect class="shade" x="10" y="528" width="540" height="10" rx="4" />

      <g class="m-all">
        <!-- feet -->
        <rect class="b-orange" x="196" y="474" width="68" height="26" rx="4" />
        <rect class="b-orange" x="296" y="474" width="68" height="26" rx="4" />

        <!-- body + wings -->
        <g data-body class="m-body">
          <g class="wing wing-l">
            <rect class="b-red" x="96" y="318" width="64" height="116" rx="8" />
            <rect class="shade" x="96" y="422" width="64" height="12" rx="5" />
          </g>
          <g class="wing wing-r">
            <rect class="b-red" x="400" y="318" width="64" height="116" rx="8" />
            <rect class="shade" x="400" y="422" width="64" height="12" rx="5" />
          </g>
          <rect class="b-blue" x="150" y="296" width="260" height="184" rx="10" />
          <rect class="belly" x="200" y="330" width="160" height="120" rx="8" />
          <rect class="shade" x="150" y="466" width="260" height="14" rx="6" />
        </g>

        <!-- head -->
        <g class="m-head" data-head>
          <g data-hat></g>
          {headStuds.map((x) => (
            <>
              <rect class="stud s-yellow" x={x} y="82" width="44" height="24" rx="5" />
              <rect class="glare" x={x + 8} y="86" width="14" height="5" rx="2" />
            </>
          ))}
          <rect class="b-yellow" x="120" y="100" width="320" height="212" rx="14" />
          <rect class="shade" x="120" y="298" width="320" height="14" rx="6" />

          <!-- left eye -->
          <rect class="eye" x="165" y="150" width="96" height="96" rx="14" />
          <g class="pupils" data-pupil="l">
            <rect class="pupil" x="194" y="181" width="38" height="38" rx="8" />
            <rect class="glint" x="216" y="186" width="10" height="10" rx="2" />
          </g>
          <!-- right eye -->
          <rect class="eye" x="299" y="150" width="96" height="96" rx="14" />
          <g class="pupils" data-pupil="r">
            <rect class="pupil" x="328" y="181" width="38" height="38" rx="8" />
            <rect class="glint" x="350" y="186" width="10" height="10" rx="2" />
          </g>

          <!-- happy ^ ^ eyes (giggle) -->
          <g class="happy-eyes">
            <path d="M189 210 L213 186 L237 210" />
            <path d="M323 210 L347 186 L371 210" />
          </g>
          <!-- blush -->
          <rect class="blush" x="136" y="256" width="52" height="22" rx="11" />
          <rect class="blush" x="372" y="256" width="52" height="22" rx="11" />

          <!-- skeptical half-lids (lift when curious) -->
          <rect class="b-yellow halflid" x="162" y="146" width="102" height="30" />
          <rect class="b-yellow halflid" x="296" y="146" width="102" height="34" />
          <!-- full lids: blink + sleep -->
          <rect class="b-yellow lid" x="162" y="146" width="102" height="104" />
          <rect class="b-yellow lid" x="296" y="146" width="102" height="104" />
          <!-- closed-eye lines while asleep -->
          <rect class="sleep-line" x="180" y="214" width="66" height="8" rx="4" />
          <rect class="sleep-line" x="314" y="214" width="66" height="8" rx="4" />

          <!-- brows -->
          <rect class="brow brow-l" x="166" y="120" width="96" height="16" rx="4" />
          <rect class="brow brow-r" x="298" y="116" width="96" height="16" rx="4" />
          <!-- stepped beak -->
          <rect class="mouth" x="258" y="266" width="44" height="22" rx="6" />
          <rect class="b-orange beak-low" x="262" y="268" width="36" height="20" rx="5" />
          <rect class="b-orange" x="248" y="236" width="64" height="38" rx="6" />
          <rect class="shade" x="248" y="264" width="64" height="8" rx="3" />
        </g>

        <!-- steam (grumpy) -->
        <g class="steam" aria-hidden="true">
          <circle cx="150" cy="80" r="16" /><circle cx="128" cy="52" r="12" />
          <circle cx="410" cy="80" r="16" /><circle cx="432" cy="52" r="12" />
        </g>

        <!-- Zzz -->
        <g class="zzz" aria-hidden="true">
          <text x="440" y="120">z</text>
          <text x="470" y="80">z</text>
          <text x="505" y="36">Z</text>
        </g>
      </g>

      <!-- the egg -->
      <g class="egg" data-egg>
        <g class="egg-shell">
          <rect x="498" y="414" width="12" height="9" rx="3" fill="#FFF6E0" stroke="rgba(0,0,0,.15)" stroke-width="2" />
          <rect x="514" y="414" width="12" height="9" rx="3" fill="#FFF6E0" stroke="rgba(0,0,0,.15)" stroke-width="2" />
          <ellipse cx="512" cy="460" rx="30" ry="38" fill="#FFF6E0" stroke="rgba(0,0,0,.15)" stroke-width="2" />
          <circle cx="498" cy="448" r="5" fill="#D01012" />
          <circle cx="524" cy="468" r="6" fill="#0055BF" />
          <circle cx="508" cy="482" r="4" fill="#237841" />
          <circle cx="527" cy="440" r="3.5" fill="#F57F20" />
          <path class="crack" d="M484 456 L494 447 L503 459 L513 446 L522 459 L531 448 L540 456" />
        </g>
      </g>

      <!-- Bitty -->
      <g class="baby" data-baby>
        <g class="baby-all">
          <rect class="b-orange" x="494" y="482" width="14" height="16" rx="3" />
          <rect class="b-orange" x="516" y="482" width="14" height="16" rx="3" />
          <rect class="b-red" x="478" y="452" width="12" height="24" rx="4" />
          <rect class="b-red" x="534" y="452" width="12" height="24" rx="4" />
          <rect class="b-green" x="488" y="446" width="48" height="40" rx="6" />
          <rect class="belly" x="498" y="454" width="28" height="24" rx="4" />
          <g class="baby-head">
            <rect class="stud s-yellow" x="494" y="396" width="14" height="10" rx="3" />
            <rect class="stud s-yellow" x="516" y="396" width="14" height="10" rx="3" />
            <rect class="b-yellow" x="480" y="404" width="64" height="46" rx="8" />
            <rect class="eye" x="487" y="415" width="21" height="21" rx="5" />
            <rect class="eye" x="516" y="415" width="21" height="21" rx="5" />
            <g data-baby-pupils>
              <rect class="pupil b-pupil-l" x="493" y="421" width="9" height="9" rx="2" />
              <rect class="pupil b-pupil-r" x="522" y="421" width="9" height="9" rx="2" />
            </g>
            <rect class="b-yellow blid" x="486" y="414" width="23" height="23" />
            <rect class="b-yellow blid" x="515" y="414" width="23" height="23" />
            <rect class="b-orange" x="505" y="437" width="14" height="9" rx="3" />
          </g>
          <text class="b-peep" x="512" y="386">peep!</text>
          <text class="b-worry" x="512" y="386">!</text>
        </g>
      </g>
    </svg>
  </button>

  <div class="m-gaze" aria-hidden="true">
    <span>GAZE</span>
    <span class="m-track"><span class="m-dot" data-dot></span></span>
    <span class="m-label" data-label>CENTRE</span>
  </div>
  <div class="m-mood" aria-hidden="true"><i></i>MOOD · <b data-mood-label>JUDGY</b></div>
  <div class="flash-egg" data-flash hidden role="dialog" aria-modal="true" aria-label="Retro Flash intro">
    <div class="fe-box">
      <p class="fe-title">AMITCODE<span>.DEV</span></p>
      <p class="fe-sub">interactive experience &middot; est. 1999</p>
      <div class="fe-bar" aria-hidden="true"><span data-flash-bar></span></div>
      <p class="fe-pct"><b data-flash-pct>0</b>% LOADING<span class="fe-dots">...</span></p>
      <p class="fe-note">This site requires the Flash 5 plug-in.<br />Best viewed at 800&times;600 on a 56k modem.</p>
      <button type="button" class="fe-skip" data-flash-skip>[ SKIP INTRO ]</button>
    </div>
  </div>

  <p class="m-hint">Poke him, tickle him (wiggle over him) — or annoy him.</p>
</div>

<style>
  .mascot { position: relative; display: flex; flex-direction: column; align-items: center; width: 100%; }
  .m-hit { touch-action: pan-y; display: block; width: 100%; max-width: 560px; padding: 0; margin: 0; border: 0; background: none; cursor: pointer; border-radius: 16px; -webkit-tap-highlight-color: transparent; }
  .m-hit:focus-visible { outline: 3px solid var(--blue); outline-offset: 6px; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }

  .b-yellow { fill: var(--yellow); }
  .b-blue { fill: var(--blue); }
  .b-red { fill: var(--red); }
  .b-green { fill: var(--green); }
  .b-orange { fill: var(--orange); }
  .s-yellow { fill: #FFD83D; }
  .s-green { fill: #2E9152; }
  .stud { stroke: rgba(0,0,0,.12); stroke-width: 1.5; }
  .glare { fill: rgba(255,255,255,.55); }
  .shade { fill: rgba(0,0,0,.18); }
  .belly { fill: rgba(255,255,255,.14); }
  .eye, .glint { fill: #FFFFFF; }
  .pupil { fill: var(--ink); }

  /* Head is moved by JS every frame */
  .m-head { transform-origin: 280px 320px; will-change: transform; }

  /* Brows: judgy by default, raised when curious */
  .brow { fill: var(--ink); transform-box: fill-box; transform-origin: center; transition: transform .22s cubic-bezier(.3,1.6,.5,1); }
  .brow-l { transform: rotate(9deg); }
  .brow-r { transform: rotate(-11deg); }
  .is-curious .brow-l { transform: translateY(-16px) rotate(-7deg); }
  .is-curious .brow-r { transform: translateY(-16px) rotate(7deg); }
  .halflid { transform-box: fill-box; transform-origin: 50% 0; transition: transform .18s ease; }
  .is-curious .halflid { transform: scaleY(0); }

  /* Lids: JS toggles .is-blinking; sleep keeps them shut */
  .lid { transform-box: fill-box; transform-origin: 50% 0; transform: scaleY(0); transition: transform 80ms ease-in; }
  .is-blinking .lid, .is-asleep .lid { transform: scaleY(1); }
  .sleep-line { fill: var(--ink); opacity: 0; transition: opacity .2s; }
  .is-asleep .sleep-line { opacity: .85; }
  .is-asleep .brow-l { transform: translateY(8px) rotate(0deg); }
  .is-asleep .brow-r { transform: translateY(10px) rotate(0deg); }

  /* Zzz */
  .zzz text { font-family: var(--display); font-weight: 900; fill: var(--blue); opacity: 0; }
  .zzz text:nth-child(1) { font-size: 34px; }
  .zzz text:nth-child(2) { font-size: 44px; }
  .zzz text:nth-child(3) { font-size: 56px; }
  .is-asleep .zzz text { animation: m-z 2.4s ease-in-out infinite; }
  .is-asleep .zzz text:nth-child(2) { animation-delay: .4s; }
  .is-asleep .zzz text:nth-child(3) { animation-delay: .8s; }
  @keyframes m-z { 0% { opacity: 0; transform: translateY(12px); } 30%, 70% { opacity: 1; } 100% { opacity: 0; transform: translateY(-14px); } }
  .is-asleep .m-all { animation: m-breathe 3.2s ease-in-out infinite; transform-origin: 280px 500px; }
  @keyframes m-breathe { 50% { transform: scale(1.015, .985); } }

  /* Hop + wing flap */
  .m-all { transform-origin: 280px 500px; }
  .is-hop .m-all { animation: m-hop .55s cubic-bezier(.3,.7,.4,1); }
  @keyframes m-hop {
    0% { transform: none; }
    18% { transform: scale(1.05, .93); }
    50% { transform: translateY(-44px) scale(.97, 1.04); }
    82% { transform: scale(1.04, .96); }
    100% { transform: none; }
  }
  .wing { transform-box: fill-box; }
  .wing-l { transform-origin: 100% 10%; }
  .wing-r { transform-origin: 0% 10%; }
  .is-hop .wing-l, .is-dance .wing-l { animation: m-flap-l .18s ease-in-out 3; }
  .is-hop .wing-r, .is-dance .wing-r { animation: m-flap-r .18s ease-in-out 3; }
  @keyframes m-flap-l { 50% { transform: rotate(28deg); } }
  @keyframes m-flap-r { 50% { transform: rotate(-28deg); } }

  /* Dance (type "bit") */
  .is-dance .m-all { animation: m-dance 1.3s ease-in-out; }
  @keyframes m-dance {
    0%, 100% { transform: none; }
    15% { transform: translateY(-30px) rotate(-8deg); }
    30% { transform: rotate(6deg); }
    45% { transform: translateY(-30px) rotate(8deg); }
    60% { transform: rotate(-6deg); }
    80% { transform: translateY(-20px) scale(1.04, .96); }
  }

  /* Brick hat */
  :global(.hat-brick) { transform-box: fill-box; transform-origin: 50% 100%; animation: m-drop .35s cubic-bezier(.3,1.5,.5,1); }
  @keyframes m-drop { from { transform: translateY(-70px); opacity: 0; } to { transform: none; opacity: 1; } }
  :global(.hat-brick.fall) { animation: m-fall .8s cubic-bezier(.5,0,.8,.4) forwards; }
  @keyframes m-fall { to { transform: translate(var(--fx), 420px) rotate(var(--fr)); opacity: 0; } }

  /* Speech bubble */
  .m-bubble {
    position: absolute; z-index: 3; top: -6px; left: 50%; max-width: 280px; width: max-content;
    padding: 12px 16px 14px; border-radius: 10px; background: var(--white); color: var(--ink);
    font-family: var(--display); font-weight: 700; font-size: 17px; line-height: 1.25; text-align: center;
    box-shadow: 0 0 0 3px var(--ink), 0 6px 0 3px var(--ink);
    opacity: 0; transform: translate(-50%, 10px) scale(.9); pointer-events: none;
    transition: opacity .18s ease, transform .22s cubic-bezier(.3,1.6,.5,1);
  }
  .m-bubble::after {
    content: ''; position: absolute; left: 50%; bottom: -15px; width: 18px; height: 18px; margin-left: -9px;
    background: var(--white); transform: rotate(45deg); box-shadow: 3px 3px 0 0 var(--ink);
  }
  .m-bubble.show { opacity: 1; transform: translate(-50%, -100%) scale(1); }
  .m-bubble:empty { display: none; }

  .m-gaze { margin-top: 4px; display: flex; align-items: center; gap: 14px; font-family: var(--mono); font-size: 12px; letter-spacing: .12em; color: var(--ink-2); }
  .m-track { position: relative; width: 180px; height: 8px; border-radius: 3px; background: #DDD8CE; box-shadow: inset 0 -2px 0 rgba(0,0,0,.1); }
  .m-dot { position: absolute; top: -5px; left: 50%; width: 18px; height: 18px; margin-left: -9px; border-radius: 4px; background: var(--red); box-shadow: inset 0 -3px 0 rgba(0,0,0,.25); }
  .m-label { width: 110px; }
  .m-hint { margin: 10px 0 0; font-size: 14px; font-weight: 600; color: var(--muted); text-align: center; }

  /* ---------- Moods ---------- */
  .m-head .b-yellow, .m-head .s-yellow { transition: fill .35s ease; }
  .blush { fill: #FF6F86; opacity: 0; transition: opacity .25s; }
  .happy-eyes path { fill: none; stroke: var(--ink); stroke-width: 11; stroke-linecap: round; stroke-linejoin: round; opacity: 0; }
  .pupils { transition: opacity .12s; }
  .mouth { fill: var(--ink); opacity: 0; transition: opacity .1s; }
  [data-mood="giggle"] .mouth { opacity: 1; }
  .beak-low { transform-box: fill-box; transition: transform .15s ease; }
  .steam circle { fill: #A8A39A; opacity: 0; }

  /* happy: relaxed brows, rosy cheeks */
  [data-mood="happy"] .brow-l { transform: translateY(-8px) rotate(-3deg); }
  [data-mood="happy"] .brow-r { transform: translateY(-8px) rotate(3deg); }
  [data-mood="happy"] .halflid { transform: scaleY(0); }
  [data-mood="happy"] .blush { opacity: .55; }
  [data-mood="happy"] .m-all { animation: m-bob 1.2s ease-in-out infinite; }
  @keyframes m-bob { 50% { transform: translateY(-6px); } }

  /* giggle: ^ ^ eyes, open beak, blush, shaking */
  [data-mood="giggle"] .pupils, [data-mood="giggle"] .eye { opacity: 0; }
  [data-mood="giggle"] .happy-eyes path { opacity: 1; }
  [data-mood="giggle"] .halflid { transform: scaleY(0); }
  [data-mood="giggle"] .brow-l { transform: translateY(-18px) rotate(-8deg); }
  [data-mood="giggle"] .brow-r { transform: translateY(-18px) rotate(8deg); }
  [data-mood="giggle"] .blush { opacity: .9; }
  [data-mood="giggle"] .beak-low { transform: translateY(12px); }
  [data-mood="giggle"] .m-all { animation: m-giggle .14s ease-in-out infinite alternate; }
  @keyframes m-giggle { from { transform: translateX(-4px) rotate(-1.5deg); } to { transform: translateX(4px) rotate(1.5deg); } }

  /* grumpy: steep low brows, squint, red face, steam */
  [data-mood="grumpy"] .brow-l { transform: translateY(14px) rotate(24deg); }
  [data-mood="grumpy"] .brow-r { transform: translateY(16px) rotate(-24deg); }
  [data-mood="grumpy"] .halflid { transform: scaleY(1.7); }
  [data-mood="grumpy"] .m-head .b-yellow { fill: #EE9A1C; }
  [data-mood="grumpy"] .m-head .s-yellow { fill: #F4AE3A; }
  [data-mood="grumpy"] .steam circle { animation: m-steam 1.1s ease-out infinite; }
  [data-mood="grumpy"] .steam circle:nth-child(2n) { animation-delay: .35s; }
  @keyframes m-steam { 0% { opacity: .9; transform: translateY(10px) scale(.6); } 100% { opacity: 0; transform: translateY(-40px) scale(1.4); } }
  .steam circle { transform-box: fill-box; transform-origin: center; }

  /* bored: droopy lids */
  [data-mood="bored"] .halflid { transform: scaleY(2.2); }
  [data-mood="bored"] .brow-l { transform: translateY(6px) rotate(0deg); }
  [data-mood="bored"] .brow-r { transform: translateY(6px) rotate(0deg); }

  .is-hop[data-mood] .m-all { animation: m-hop .55s cubic-bezier(.3,.7,.4,1); }
  .is-dance[data-mood] .m-all { animation: m-dance 1.3s ease-in-out; }

  .m-mood { margin-top: 10px; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px 8px; border-radius: 6px; background: var(--white); font-family: var(--mono); font-size: 12px; letter-spacing: .12em; color: var(--ink-2); box-shadow: inset 0 -3px 0 rgba(0,0,0,.08), 0 2px 0 rgba(0,0,0,.08); }
  .m-mood i { width: 10px; height: 10px; border-radius: 3px; background: var(--ink); transition: background .2s; }
  .m-mood b { font-weight: 500; color: var(--ink); }
  [data-mood="happy"] .m-mood i, [data-mood="giggle"] .m-mood i { background: #FF6F86; }
  [data-mood="grumpy"] .m-mood i { background: var(--red); }
  [data-mood="bored"] .m-mood i { background: #A8A39A; }
  .is-asleep .m-mood i { background: var(--blue); }

  /* ---------- Egg + Bitty ---------- */
  .egg, .baby { visibility: hidden; }
  .egg-in .egg { visibility: visible; }
  .has-baby .baby { visibility: visible; }
  .egg-shell { transform-box: fill-box; transform-origin: 50% 100%; }
  .egg-in .egg-shell { animation: egg-drop .5s cubic-bezier(.3,1.5,.5,1); }
  .egg-wobble .egg-shell { animation: egg-wobble .16s ease-in-out infinite alternate; }
  @keyframes egg-drop { from { transform: translateY(-220px); } to { transform: none; } }
  @keyframes egg-wobble { from { transform: rotate(-9deg); } to { transform: rotate(9deg); } }
  .crack { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linejoin: round; opacity: 0; }
  .egg-crack .crack { opacity: 1; }
  .baby-all { transform-box: view-box; transform-origin: 512px 498px; }
  .baby-pop .baby-all { animation: b-pop .6s cubic-bezier(.3,1.6,.5,1); }
  @keyframes b-pop { from { transform: scale(0) translateY(20px); } to { transform: none; } }
  .baby-head { transform-box: view-box; transform-origin: 512px 450px; transition: transform .2s ease; }
  .blid { transform-box: fill-box; transform-origin: 50% 0; transform: scaleY(0); transition: transform 80ms ease-in 60ms; }
  .is-blinking .blid, .is-asleep .blid { transform: scaleY(1); }
  /* copy dad */
  .is-hop .baby-all, .baby-hop .baby-all { animation: b-hop .45s cubic-bezier(.3,.7,.4,1) .1s; }
  @keyframes b-hop { 50% { transform: translateY(-26px); } }
  .is-dance .baby-all { animation: b-dance 1.3s ease-in-out .15s; }
  @keyframes b-dance { 15%, 45% { transform: translateY(-18px) rotate(10deg); } 30%, 60% { transform: rotate(-10deg); } }
  [data-mood="giggle"] .baby-all { animation: m-giggle .12s ease-in-out infinite alternate; }
  .is-asleep .baby-head { transform: translateY(4px) rotate(-6deg); }
  .b-peep, .b-worry { font-family: var(--display); font-weight: 900; text-anchor: middle; opacity: 0; transition: opacity .15s; }
  .b-peep { font-size: 20px; fill: var(--ink); }
  .b-worry { font-size: 34px; fill: var(--red); }
  .peeping .b-peep { opacity: 1; }
  [data-mood="grumpy"] .has-baby .b-worry, .has-baby[data-mood="grumpy"] .b-worry { opacity: 1; }

  /* ---------- "flash" easter egg ---------- */
  .flash-egg {
    position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 16px;
    background: #050505; color: #D8D8D8; font-family: var(--mono);
    background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 3px);
    transition: opacity .35s ease;
  }
  .flash-egg[hidden] { display: none; }
  .flash-egg.out { opacity: 0; }
  .fe-box { width: min(520px, 100%); text-align: center; }
  .fe-title {
    margin: 0; font-family: var(--display); font-weight: 900; font-size: clamp(36px, 8vw, 64px); letter-spacing: .04em;
    background: linear-gradient(180deg, #FFFFFF 0%, #9A9A9A 48%, #F2F2F2 52%, #6E6E6E 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 12px rgba(120,180,255,.35));
  }
  .fe-title span { background: linear-gradient(180deg, #FFD36B, #F57F20); -webkit-background-clip: text; background-clip: text; }
  .fe-sub { margin: 6px 0 34px; font-size: 12px; letter-spacing: .4em; text-transform: uppercase; color: #7FA7D8; }
  .fe-bar { height: 18px; padding: 3px; border: 1px solid #5A5A5A; background: #111; }
  .fe-bar span {
    display: block; height: 100%; width: 0;
    background: repeating-linear-gradient(90deg, #F57F20 0 14px, transparent 14px 18px);
  }
  .fe-pct { margin: 14px 0 0; font-size: 14px; letter-spacing: .2em; }
  .fe-pct b { color: #FFD36B; font-weight: 500; }
  .fe-dots { animation: fe-blink 1s steps(2) infinite; }
  @keyframes fe-blink { 50% { opacity: 0; } }
  .fe-note { margin: 28px 0 0; font-size: 12px; line-height: 1.8; color: #8C8C8C; }
  .fe-skip {
    margin-top: 26px; min-height: 44px; padding: 0 18px; border: 1px solid #8C8C8C; background: transparent; color: #D8D8D8;
    font: inherit; font-size: 13px; letter-spacing: .2em; cursor: pointer;
  }
  .fe-skip:hover, .fe-skip:focus-visible { background: #D8D8D8; color: #050505; outline: none; }

  @media (prefers-reduced-motion: reduce) {
    .fe-dots { animation: none; }
    [data-mood] .m-all, [data-mood="grumpy"] .steam circle { animation: none !important; }
    [data-mood="grumpy"] .steam circle { opacity: .6; }
    .is-hop .m-all, .is-dance .m-all, .is-asleep .m-all, .is-hop .wing-l, .is-hop .wing-r, .is-dance .wing-l, .is-dance .wing-r { animation: none; }
    .is-asleep .zzz text { animation: none; opacity: 1; }
    :global(.hat-brick) { animation: none; }
    .egg-in .egg-shell, .egg-wobble .egg-shell, .baby-pop .baby-all, .is-hop .baby-all, .baby-hop .baby-all, .is-dance .baby-all, [data-mood="giggle"] .baby-all { animation: none; }
  }
  @media (max-width: 720px) {
    .m-track { width: 120px; }
    .m-bubble { font-size: 15px; max-width: 220px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-mascot]');
  if (root) {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const svg = $<SVGSVGElement>('svg');
    const hit = $<HTMLButtonElement>('[data-hit]');
    const head = $<SVGGElement>('[data-head]');
    const body = $<SVGGElement>('[data-body]');
    const hat = $<SVGGElement>('[data-hat]');
    const pupilL = $<SVGGElement>('[data-pupil="l"]');
    const pupilR = $<SVGGElement>('[data-pupil="r"]');
    const bubble = $<HTMLElement>('[data-bubble]');
    const dot = $<HTMLElement>('[data-dot]');
    const label = $<HTMLElement>('[data-label]');
    const moodLabel = $<HTMLElement>('[data-mood-label]');
    const babyPupils = $<SVGGElement>('[data-baby-pupils]');
    const flashEgg = $<HTMLElement>('[data-flash]');
    const flashBar = $<HTMLElement>('[data-flash-bar]');
    const flashPct = $<HTMLElement>('[data-flash-pct]');
    const flashSkip = $<HTMLButtonElement>('[data-flash-skip]');

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = matchMedia('(pointer: fine)').matches;
    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
    const pick = <T,>(a: T[]) => a[Math.floor(Math.random() * a.length)];

    // Geometry, in SVG units
    const MID = { x: 280, y: 198 };
    const EYE_L = { x: 213, y: 198 };
    const EYE_R = { x: 347, y: 198 };
    const SLEEP_AFTER = 12000;

    const QUIPS = [
      'Ship it.',
      'Did you write tests for that?',
      'Works on my machine.',
      'LGTM. Mostly.',
      'That’s not a bug. It’s a feature.',
      'Deploying on a Friday? Bold.',
      'Have you tried turning it off and on again?',
      'git push --force? Please don’t.',
      'I’m not a rubber duck. I’m a brick bird.',
      'Nice clicking. Very scalable.',
      'Needs more unit tests.',
      'Refactor later. Famous last words.',
    ];
    const GIGGLES = ['Hehe! Stop it!', 'That tickles!', 'Hahaha — not the belly!', 'Okay okay, I surrender!'];
    const GRUMPY = ['Okay. That’s enough.', 'I’m not talking to you.', 'Ticket raised: user is annoying.', 'Rate limit exceeded. Try again later.'];
    const STILL_GRUMPY = ['Still grumpy.', 'No.', 'Talk to the wing.', '429 Too Many Pokes.'];
    const DRIFT = [
      { mood: 'happy', line: 'Good vibes today.' },
      { mood: 'happy', line: 'Tests are green. Life is good.' },
      { mood: 'bored', line: 'Is anyone going to click me?' },
      { mood: 'bored', line: 'Waiting for the build…' },
    ];
    const HAT_COLOURS = ['#D01012', '#0055BF', '#237841', '#F57F20'];

    // ---- state ----
    const target = { x: MID.x - 60, y: MID.y + 10 };
    const cur = { x: target.x, y: target.y };
    let lastMove = performance.now();
    let asleep = false;
    let visible = true;
    let bubbleTimer = 0;
    let hatCount = 0;
    type Mood = 'judgy' | 'happy' | 'giggle' | 'grumpy' | 'bored';
    let mood: Mood = 'judgy';
    let moodTimer = 0;
    let irritation = 0;          // rises with each click, drains over time
    let over = false;            // pointer is over Bit
    let lastDir = 0;             // tickle: last horizontal direction
    let flips: number[] = [];    // tickle: timestamps of direction changes
    let nextDrift = performance.now() + 20000;
    let lastT = performance.now();
    let play = 0;                // how much the visitor has played; enough hatches the egg
    let hatched = false;
    let egging = false;
    const HATCH_AT = 12;
    const PROUD = ['That’s my kid.', 'He gets his looks from me.', 'Careful, he’s still in beta.', 'Future senior engineer.', 'He already knows Git. Mostly.'];
    const store = {
      get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
      set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
    };

    // ---- helpers ----
    function say(text: string, ms = 2200) {
      bubble.textContent = text;
      bubble.classList.add('show');
      clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(() => bubble.classList.remove('show'), ms);
    }

    function flash(cls: string, ms: number) {
      root!.classList.remove(cls);
      void root!.getBoundingClientRect(); // restart the animation
      root!.classList.add(cls);
      window.setTimeout(() => root!.classList.remove(cls), ms);
    }

    function setMood(m: Mood, ms = 0, after?: () => void) {
      mood = m;
      root!.dataset.mood = m;
      moodLabel.textContent = m === 'giggle' ? 'TICKLED' : m.toUpperCase();
      clearTimeout(moodTimer);
      if (ms) moodTimer = window.setTimeout(() => { setMood('judgy'); after?.(); }, ms);
    }
    setMood('judgy');

    function wake(silent = false) {
      if (!asleep) return;
      asleep = false;
      root!.classList.remove('is-asleep');
      setMood('judgy');
      if (!silent) {
        say('I’m up! I was just… compiling.');
        flash('is-hop', 560);
      }
    }

    function topple() {
      if (!hatCount) return;
      hat.querySelectorAll<SVGGElement>('.hat-brick').forEach((b, i) => {
        b.style.setProperty('--fx', `${(i % 2 ? 1 : -1) * (60 + i * 40)}px`);
        b.style.setProperty('--fr', `${(i % 2 ? 1 : -1) * (40 + i * 25)}deg`);
        b.classList.add('fall');
      });
      window.setTimeout(() => { hat.replaceChildren(); }, 820);
      hatCount = 0;
    }

    function addHatBrick() {
      const NS = 'http://www.w3.org/2000/svg';
      if (hatCount >= 4) {
        topple();
        say('Tower collapsed. Classic prod incident.', 2600);
        return;
      }
      const i = hatCount++;
      const colour = HAT_COLOURS[i % HAT_COLOURS.length];
      const y = 52 - i * 36; // each brick sits on the studs of the one below
      const g = document.createElementNS(NS, 'g');
      g.setAttribute('class', 'hat-brick');
      const rect = (x: number, yy: number, w: number, h: number, rx: number, fill: string) => {
        const r = document.createElementNS(NS, 'rect');
        r.setAttribute('x', String(x)); r.setAttribute('y', String(yy));
        r.setAttribute('width', String(w)); r.setAttribute('height', String(h));
        r.setAttribute('rx', String(rx)); r.setAttribute('fill', fill);
        g.appendChild(r);
      };
      [216, 264, 312].forEach((sx) => rect(sx, y - 11, 32, 14, 4, colour)); // studs
      rect(200, y, 160, 34, 6, colour);
      rect(200, y + 26, 160, 8, 3, 'rgba(0,0,0,.2)');
      hat.appendChild(g);
      say(pick(QUIPS));
    }

    // ---- Bitty ----
    function peep() {
      root!.classList.add('peeping');
      window.setTimeout(() => root!.classList.remove('peeping'), 900);
    }
    function addPlay(n: number) {
      play += n;
      if (!hatched && !egging && play >= HATCH_AT) layEgg();
    }
    function layEgg() {
      egging = true;
      root!.classList.add('egg-in');
      window.setTimeout(() => say('Wait… what’s that?', 1800), 500);
      window.setTimeout(() => root!.classList.add('egg-wobble'), 1900);
      window.setTimeout(() => root!.classList.add('egg-crack'), 2800);
      window.setTimeout(hatch, 3700);
    }
    function hatch(quiet = false) {
      hatched = true;
      egging = false;
      root!.classList.remove('egg-in', 'egg-wobble', 'egg-crack');
      root!.classList.add('has-baby');
      store.set('bit-baby', '1');
      if (quiet) return;
      flash('baby-pop', 620);
      window.setTimeout(peep, 300);
      wake(true);
      flash('is-dance', 1320);
      say('It’s a baby brick! Meet Bitty.', 3200);
    }
    if (store.get('bit-baby') === '1') {
      hatch(true);
      window.setTimeout(() => { if (visible && !asleep) { peep(); say('Bitty missed you!', 2400); } }, 1600);
    }

    // ---- input ----
    addEventListener('pointermove', (e) => {
      const r = svg.getBoundingClientRect();
      const s = 560 / r.width;
      target.x = (e.clientX - r.left) * s;
      target.y = (e.clientY - r.top) * s;
      const now = performance.now();
      lastMove = now;
      wake();
      // Tickle: fast back-and-forth over Bit
      if (over && mood !== 'grumpy' && Math.abs(e.movementX) > 3) {
        const dir = Math.sign(e.movementX);
        if (dir !== lastDir) { flips.push(now); lastDir = dir; }
        flips = flips.filter((f) => now - f < 900);
        if (flips.length >= 6 && mood !== 'giggle') {
          flips = [];
          setMood('giggle', 2600, () => setMood('happy', 5000));
          say(pick(GIGGLES), 2400);
          addPlay(3);
        }
      }
    }, { passive: true });
    addEventListener('scroll', () => { lastMove = performance.now(); wake(true); }, { passive: true });

    hit.addEventListener('pointerenter', () => { over = true; root.classList.add('is-curious'); });
    hit.addEventListener('pointerleave', () => { over = false; flips = []; root.classList.remove('is-curious'); });
    hit.addEventListener('focus', () => root.classList.add('is-curious'));
    hit.addEventListener('blur', () => root.classList.remove('is-curious'));

    hit.addEventListener('click', (e) => {
      lastMove = performance.now();
      if (asleep) { wake(); return; }
      if (hatched && (e.target as Element).closest?.('[data-baby]')) {
        flash('baby-hop', 560);
        peep();
        say(pick(PROUD), 2000);
        return;
      }
      if (mood === 'grumpy') { say(pick(STILL_GRUMPY), 1600); return; }
      irritation += 1;
      if (irritation >= 5) {
        irritation = 0;
        topple(); // knocks his own hat off in a huff
        setMood('grumpy', 6500, () => say('…fine.', 1600));
        say(pick(GRUMPY), 2600);
        return;
      }
      flash('is-hop', 560);
      addHatBrick();
      addPlay(1);
    });

    // Easter egg: type "bit"
    let typed = '';
    addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.metaKey || e.ctrlKey || e.altKey || t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
      if (e.key.length !== 1) return;
      typed = (typed + e.key.toLowerCase()).slice(-5);
      if (typed === 'flash') { typed = ''; runFlash(); return; }
      if (typed.endsWith('bit')) {
        typed = '';
        wake(true);
        flash('is-dance', 1320);
        say('You found me!', 2400);
        addPlay(2);
      }
    });

    // ---- "flash": a 1999 intro loader, dial-up pacing included ----
    let flashTimer = 0;
    let flashReturnFocus: HTMLElement | null = null;
    function runFlash() {
      if (!flashEgg.hidden) return;
      flashReturnFocus = document.activeElement as HTMLElement | null;
      flashEgg.hidden = false;
      flashEgg.classList.remove('out');
      flashSkip.focus();
      let pct = 0;
      const tick = () => {
        // Speedy start, crawl through the 90s, a long stall at 99%
        pct += pct < 60 ? 7 + Math.random() * 9 : pct < 95 ? 2 + Math.random() * 4 : 1;
        pct = Math.min(pct, 100);
        flashBar.style.width = `${pct}%`;
        flashPct.textContent = String(Math.floor(pct));
        if (pct >= 100) { flashTimer = window.setTimeout(endFlash, 400); return; }
        flashTimer = window.setTimeout(tick, pct >= 99 ? 900 : 110 + Math.random() * 160);
      };
      tick();
    }
    function endFlash(skipped = false) {
      if (flashEgg.hidden) return;
      clearTimeout(flashTimer);
      flashEgg.classList.add('out');
      window.setTimeout(() => {
        flashEgg.hidden = true;
        flashBar.style.width = '0';
        flashPct.textContent = '0';
        flashReturnFocus?.focus?.();
        wake(true);
        flash('is-dance', 1320);
        say(skipped ? 'Everyone always skipped the intro.' : 'Flash is dead. Long live SVG.', 2800);
        addPlay(2);
      }, 350);
    }
    flashSkip.addEventListener('click', () => endFlash(true));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') endFlash(true); });

    // ---- blinking (JS-driven so it never gets stuck) ----
    function scheduleBlink() {
      window.setTimeout(() => {
        if (!asleep && visible) {
          root!.classList.add('is-blinking');
          window.setTimeout(() => root!.classList.remove('is-blinking'), 120);
          if (Math.random() < 0.25) {
            window.setTimeout(() => {
              root!.classList.add('is-blinking');
              window.setTimeout(() => root!.classList.remove('is-blinking'), 110);
            }, 260);
          }
        }
        scheduleBlink();
      }, 2600 + Math.random() * 3400);
    }
    if (!reduced) scheduleBlink();

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);

    // ---- render loop ----
    function place(pupil: SVGGElement, eye: { x: number; y: number }) {
      // Grumpy: look pointedly away from the cursor. Bored: stare at the ceiling.
      const lx = mood === 'grumpy' ? 2 * MID.x - cur.x : mood === 'bored' ? eye.x + 60 : cur.x;
      const ly = mood === 'bored' ? eye.y - 200 : cur.y;
      const dx = lx - eye.x;
      const dy = ly - eye.y;
      const k = Math.min(1, Math.hypot(dx, dy) / 220);
      const a = Math.atan2(dy, dx);
      pupil.style.transform = `translate(${Math.cos(a) * 18 * k}px, ${Math.sin(a) * 16 * k}px)`;
    }

    function frame(t: number) {
      requestAnimationFrame(frame);
      if (!visible) return;

      const idle = t - lastMove;
      irritation = Math.max(0, irritation - (t - lastT) / 1500);
      lastT = t;

      // Every so often, drift into a mood on his own
      if (t > nextDrift) {
        nextDrift = t + 25000 + Math.random() * 20000;
        if (!asleep && mood === 'judgy' && idle > 4000) {
          const d = pick(DRIFT);
          setMood(d.mood as Mood, 8000);
          say(d.line, 2600);
        }
      }
      if (!finePointer && idle > 3500) {
        // Touch screens: glance around on his own
        target.x = MID.x + Math.sin(t / 1800) * 420;
        target.y = MID.y + Math.cos(t / 2600) * 120;
      }
      if (finePointer && !asleep && idle > SLEEP_AFTER) {
        asleep = true;
        root!.classList.add('is-asleep');
        setMood('judgy');
        moodLabel.textContent = 'SLEEPY';
        bubble.classList.remove('show');
      }

      const ease = reduced ? 1 : 0.14;
      cur.x += (target.x - cur.x) * ease;
      cur.y += (target.y - cur.y) * ease;

      place(pupilL, EYE_L);
      place(pupilR, EYE_R);
      if (hatched) {
        // Bitty watches the cursor, or worriedly watches dad when he's grumpy
        const bx = mood === 'grumpy' ? MID.x : cur.x;
        const by = mood === 'grumpy' ? MID.y + 100 : cur.y;
        const bdx = bx - 512, bdy = by - 426;
        const bk = Math.min(1, Math.hypot(bdx, bdy) / 160);
        const ba = Math.atan2(bdy, bdx);
        babyPupils.style.transform = `translate(${Math.cos(ba) * 5 * bk}px, ${Math.sin(ba) * 5 * bk}px)`;
      }

      const away = mood === 'grumpy' ? -1 : 1;
      const dx = asleep ? 0 : (cur.x - MID.x) * away;
      const dy = asleep ? 30 : cur.y - MID.y;
      if (!reduced) {
        const tilt = clamp(dx / 80, -8, 8);
        const hx = clamp(dx / 40, -18, 18);
        const hy = clamp(dy / 70, -8, 8);
        head.style.transform = `translate(${hx}px, ${hy}px) rotate(${tilt}deg)`;
        body.style.transform = `translateX(${hx * 0.3}px)`;
      }

      const deg = Math.round(clamp(dx / 800, -1, 1) * 60);
      dot.style.left = `${50 + (deg / 60) * 50}%`;
      label.textContent = asleep ? 'ASLEEP' : Math.abs(deg) < 3 ? 'CENTRE' : `${Math.abs(deg)}° ${deg < 0 ? 'LEFT' : 'RIGHT'}`;
    }
    requestAnimationFrame(frame);
  }
</script>
